# ─────────────────────────────────────────────
#  Executo Backend — Environment Variables
#  Copy this file to .env and fill in the values
#  cp .env.example .env
# ─────────────────────────────────────────────


# ── PostgreSQL ────────────────────────────────
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
# When running via Docker Compose, host = "postgres" (service name)
# When running locally, host = "localhost"
#
# HOW TO GET: No external service needed.
# Just set a strong password — Docker Compose creates the DB automatically.
# The user/dbname must match POSTGRES_USER and POSTGRES_DB in your root .env
#
POSTGRES_URL=postgres://executo:CHANGE_ME_STRONG_PASSWORD@localhost:5432/executo_db?sslmode=disable


# ── Redis ─────────────────────────────────────
# Format: redis://<host>:<port>
# When running via Docker Compose, host = "redis" (service name)
# When running locally, host = "localhost"
#
# HOW TO GET: No external service needed.
# Redis runs as a Docker container — no account or key required.
#
REDIS_URL=redis://localhost:6379


# ── Judge0 (Code Execution Engine) ───────────
#
# OPTION A — Self-hosted (recommended, free, used in Docker Compose)
# Judge0 runs as a Docker container on port 2358.
# When running via Docker Compose, use the service name: judge0-server
# When running locally, use: http://localhost:2358
# No API key needed for self-hosted.
#
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# OPTION B — RapidAPI hosted Judge0 (easier to start, 50 free req/day)
# HOW TO GET:
#   1. Go to https://rapidapi.com/judge0-official/api/judge0-ce
#   2. Click "Subscribe to Test" → select the FREE plan (50 req/day)
#   3. Sign up / log in to RapidAPI
#   4. After subscribing, go to the "Endpoints" tab
#   5. On the right panel, find "X-RapidAPI-Key" — copy that value
#   6. Set JUDGE0_URL and JUDGE0_API_KEY below, comment out OPTION A above
#
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com


# ── JWT Secret ────────────────────────────────
# Used to sign and verify JWT tokens for auth.
# Must be at least 32 characters. Use a random string — never share this.
#
# HOW TO GENERATE (pick any one):
#   Option 1 (Linux/Mac terminal):  openssl rand -hex 32
#   Option 2 (Node.js):             node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Option 3 (online):              https://generate-secret.vercel.app/32
#
JWT_SECRET=CHANGE_ME_REPLACE_WITH_32_CHAR_RANDOM_STRING


# ── Backend Server ────────────────────────────
# Port the Go HTTP server listens on.
# No changes needed unless port 8080 is already in use on your machine.
#
BACKEND_PORT=8080


# ── Optional: Grafana ─────────────────────────
# Password for the Grafana admin user (default login: admin / admin)
# Change this before deploying to production.
#
# HOW TO GET: No external service needed. Just set any password you want.
#
GRAFANA_PASSWORD=admin
